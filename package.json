  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:api": "node --env-file=.env -e \"const base=process.env.EXPO_PUBLIC_API_URL;if(!base)throw new Error('EXPO_PUBLIC_API_URL não configurada');const url=base.endsWith('/')?base+'health':base+'/health';fetch(url).then(async(r)=>{if(!r.ok)throw new Error('HTTP '+r.status);console.log(await r.text())}).catch((e)=>{console.error(e.message);process.exit(1)})\"",
    "test:firebase-rules": "npx -y firebase-tools@14.22.0 emulators:exec --project demo-cp5-rules --only firestore,database \"node firebase.rules.test.mjs\""
  },
  "private": true
}
