rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      
      match /devices/{deviceId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
    }

    match /directConversations/{conversationId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && request.resource.data.participantIds.size() == 2 && request.auth.uid in request.resource.data.participantIds && request.resource.data.participantIds[0] < request.resource.data.participantIds[1] && conversationId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1];
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds && request.resource.data.participantIds == resource.data.participantIds;
    }
  }
}
