rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDocOwner(uid) {
      return isOwner(uid);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || (('uid' in resource.data)
          && request.resource.data.uid == resource.data.uid);
    }

    function isHttpsUrlOrEmpty(value) {
      return value is string
        && value.size() <= 2048
        && (value == '' || value.matches('^https://.*'));
    }

    function isValidUser(data) {
      return data.keys().hasOnly([
          'name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'
        ])
        && data.keys().hasAll([
          'name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email.matches('^[^@]+@[^@]+[.][^@]+$')
        && data.phoneNumber is string
        && data.phoneNumber.size() >= 8
        && data.phoneNumber.size() <= 20
        && data.birthDate is string
        && data.birthDate.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$')
        && isHttpsUrlOrEmpty(data.photoUrl)
        && data.createdAt is int
        && data.createdAt > 0;
    }

    function isValidDevice(data) {
      return data.keys().hasOnly(['token', 'platform', 'enabled', 'updatedAt'])
        && data.keys().hasAll(['token', 'platform', 'enabled', 'updatedAt'])
        && data.token is string
        && data.token.size() >= 1
        && data.token.size() <= 512
        && data.platform in ['android', 'ios']
        && data.enabled is bool
        && data.updatedAt is int
        && data.updatedAt > 0;
    }

    function isValidDirectConversation(data, conversationId) {
      return data.keys().hasOnly([
          'participantIds', 'createdAt', 'notificationPolicy', 'updatedAt'
        ])
        && data.keys().hasAll(['participantIds', 'createdAt'])
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.participantIds[0] is string
        && data.participantIds[0].size() >= 1
        && data.participantIds[0].size() <= 128
        && data.participantIds[1] is string
        && data.participantIds[1].size() >= 1
        && data.participantIds[1].size() <= 128
        && data.participantIds[0] < data.participantIds[1]
        && conversationId == data.participantIds[0] + '_' + data.participantIds[1]
        && data.createdAt is int
        && data.createdAt > 0
        && (!('notificationPolicy' in data) || data.notificationPolicy == 'disabled')
        && (!('updatedAt' in data) || (data.updatedAt is int && data.updatedAt >= data.createdAt));
    }

    match /users/{uid} {
      allow get: if isDocOwner(uid);
      allow create: if isDocOwner(uid)
        && uidUnchanged()
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && isValidUser(request.resource.data);
      allow update: if isDocOwner(uid)
        && uidNotModified()
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidUser(request.resource.data);
      
      match /devices/{deviceId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidDevice(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
    }

    match /directConversations/{conversationId} {
      allow get: if isAuthenticated()
        && (!exists(/databases/$(database)/documents/directConversations/$(conversationId))
          || request.auth.uid in resource.data.participantIds);
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds
        && isValidDirectConversation(request.resource.data, conversationId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
