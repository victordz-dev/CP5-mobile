{
  "rules": {
    "chat_members": {
      "$conversationId": {
        ".read": false,
        ".write": false
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "root.child('chat_members').child($conversationId).child(auth.uid).val() === true",
        ".write": "root.child('chat_members').child($conversationId).child(auth.uid).val() === true",
        "$messageId": {
          ".validate": "newData.hasChildren(['conversationType', 'senderId', 'text', 'target', 'createdAt']) && newData.child('senderId').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0"
        }
      }
    }
  }
}
