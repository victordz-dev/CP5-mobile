{
  "rules": {
    ".read": false,
    ".write": false,
    "chat_members": {
      "$conversationId": {
        ".read": false,
        ".write": false
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "auth != null && root.child('chat_members').child($conversationId).child(auth.uid).val() === true",
        ".indexOn": ["createdAt"],
        "$messageId": {
          ".write": "auth != null && root.child('chat_members').child($conversationId).child(auth.uid).val() === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['id', 'conversationId', 'conversationType', 'senderId', 'text', 'target', 'createdAt']) && !newData.child('pushSent').exists()",
          "id": {
            ".validate": "newData.isString() && newData.val() === $messageId && newData.val().length > 0 && newData.val().length <= 1500"
          },
          "conversationId": {
            ".validate": "newData.isString() && newData.val() === $conversationId && newData.val().length > 0 && newData.val().length <= 1500"
          },
          "conversationType": {
            ".validate": "newData.val() === 'direct' || newData.val() === 'group'"
          },
          "senderId": {
            ".validate": "newData.isString() && newData.val() === auth.uid && newData.val().length > 0 && newData.val().length <= 128"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10000"
          },
          "target": {
            ".validate": "newData.hasChild('type') && ((newData.child('type').val() === 'conversation' && !newData.hasChild('memberId')) || (newData.child('type').val() === 'member' && newData.hasChild('memberId')))",
            "type": {
              ".validate": "newData.val() === 'conversation' || newData.val() === 'member'"
            },
            "memberId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && root.child('chat_members').child($conversationId).child(newData.val()).val() === true"
            },
            "$other": {
              ".validate": false
            }
          },
          "mentionedUserIds": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9][0-9]?)$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && root.child('chat_members').child($conversationId).child(newData.val()).val() === true"
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
